---
import Layout from "../layouts/Layout.astro";
import SuccessMessage from "../components/SuccessMessage.astro";
import Button from "../components/Button.astro";
---

<Layout
  title="Application Received | Forge Academy"
  description="Forge Academy application confirmation."
>
  <div class="success-page site-shell">
    <SuccessMessage
      title="Application received."
      message="Your cohort application has been submitted through Wix Headless. The Forge team can now review your track, level, and contact details."
    >
      <div class="success-actions">
        <a href="/" class="inline-block">
          <Button variant="primary">Return to Home</Button>
        </a>
      </div>
    </SuccessMessage>
  </div>
</Layout>
